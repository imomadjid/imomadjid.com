{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imomadjid-com",
  "workers_dev": true,
  "routes": [{ "pattern": "imomadjid.com", "custom_domain": true }],
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  // Start's handler, wrapped to answer byte ranges for the preview videos (see "assets").
  "main": "./src/server.ts",
  "assets": {
    "binding": "ASSETS",
    // Static assets ignore byte ranges, so the preview videos go through src/server.ts, which
    // answers them. Everything else is still served before the Worker runs.
    "run_worker_first": ["/assets/*.webm", "/assets/*.mp4"],
  },
  "env": {
    // dev.imomadjid.com: a separate Worker built with `CLOUDFLARE_ENV=dev`, from the dev branch.
    "dev": {
      "name": "imomadjid-com-dev",
      "routes": [{ "pattern": "dev.imomadjid.com", "custom_domain": true }],
      // The postmark footer's ledger (src/lib/postmark-ledger-object.ts): one SQLite-backed
      // Durable Object holding every visitor's stamp. Production binds it once the footer ships.
      "durable_objects": { "bindings": [{ "name": "POSTMARKS", "class_name": "PostmarkLedger" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PostmarkLedger"] }],
    },
  },
}
