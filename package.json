{
  "name": "imomadjidcom",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "intent": "node ./node_modules/@tanstack/intent/dist/cli.mjs",
    "dev": "vp dev --port 3000",
    "build": "vp build",
    "build:dev": "CLOUDFLARE_ENV=dev vp build",
    "preview": "vp preview",
    "lint": "vp lint",
    "lint:fix": "bun run lint --fix",
    "format": "vp fmt --write",
    "format:check": "vp fmt --check",
    "typecheck": "tsc --noEmit",
    "check": "vp check && tsc --noEmit",
    "test": "bun test",
    "doctor": "react-doctor --yes --no-telemetry --no-supply-chain --blocking error",
    "doctor:staged": "react-doctor --staged --yes --no-telemetry --no-supply-chain --blocking warning",
    "deadcode": "fallow dead-code --format json --quiet",
    "audit:code": "fallow --format json --quiet",
    "audit:ui": "shadscan --no-roast",
    "audit:ui:browser": "shadscan --check-ui",
    "deps:check": "taze",
    "prepare": "lefthook install",
    "deploy": "bun run build && wrangler deploy",
    "deploy:dev": "bun run build:dev && wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@scritto/react": "0.1.0",
    "@tabler/icons-react": "^3.52.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-devtools": "^0.10.15",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.4",
    "@tanstack/react-start": "^1.169.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "cuelume": "./vendor/cuelume-0.2.9.tgz",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "vgpu": "0.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@oxlint/plugins": "1.94.0",
    "@shadscan/cli": "0.17.0",
    "@tanstack/devtools-vite": "^0.8.7",
    "@tanstack/intent": "^0.5.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@webgpu/types": "0.1.74",
    "fallow": "3.45.0",
    "lefthook": "2.2.2",
    "playwright-core": "1.61.1",
    "react-doctor": "0.9.23",
    "taze": "21.3.0",
    "typescript": "7.0.2",
    "vite-plus": "1.7.0",
    "wrangler": "^4.166.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "bun@1.4.5",
  "intent": {
    "skills": [
      "@tanstack/react-start",
      "@tanstack/start-client-core",
      "@tanstack/start-server-core",
      "@tanstack/router-core",
      "@tanstack/router-plugin",
      "@tanstack/virtual-file-routes"
    ]
  }
}
